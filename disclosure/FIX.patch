+// checkSyso rejects Go compiler objects presented as system object files.
+// Go objects can carry //go:cgo_ldflag directives, which are only safe after
+// cmd/go has validated the generated cgo source that produced them. A .syso
+// file is supplied by the package and has not passed that validation.
+func checkSyso(file string) error {
+	f, err := os.Open(file)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	const goObject = "go object "
+	var hdr [len(goObject)]byte
+	n, err := io.ReadFull(f, hdr[:])
+	if err != nil && err != io.EOF && err != io.ErrUnexpectedEOF {
+		return err
+	}
+	if string(hdr[:n]) == goObject {
+		return fmt.Errorf("invalid system object file %s: contains a Go object", file)
+	}
+	return nil
+}
