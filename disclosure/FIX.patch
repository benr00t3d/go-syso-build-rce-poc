--- a/src/cmd/go/internal/work/exec_test.go
+++ b/src/cmd/go/internal/work/exec_test.go
@@ -10,11 +10,39 @@ import (
 	"cmd/internal/sys"
 	"fmt"
 	"math/rand"
+	"os"
+	"path/filepath"
 	"testing"
 	"time"
 	"unicode/utf8"
 )
 
+func TestCheckSyso(t *testing.T) {
+	t.Parallel()
+
+	dir := t.TempDir()
+	for _, test := range []struct {
+		name    string
+		data    string
+		wantErr bool
+	}{
+		{name: "native object", data: "\x7fELF"},
+		{name: "short file", data: "go obj"},
+		{name: "Go object", data: "go object linux amd64", wantErr: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			file := filepath.Join(dir, test.name+".syso")
+			if err := os.WriteFile(file, []byte(test.data), 0o666); err != nil {
+				t.Fatal(err)
+			}
+			err := checkSyso(file)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("checkSyso(%q) = %v, want error %v", file, err, test.wantErr)
+			}
+		})
+	}
+}
