{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GO-F0003 macOS Calculator demo",
      "type": "shell",
      "command": "./verify-macos.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
